[gd_scene format=3]
[ext_resource type="Script" path="res://scripts/interface/loading_display.gd" id="1"]
[sub_resource type="StyleBoxFlat" id="Track"]
bg_color = Color(0.2, 0.36, 0.38, 0.12)

[sub_resource type="StyleBoxFlat" id="Fill"]
bg_color = Color(0.2, 0.36, 0.38, 0.8)

[node name="Loading" type="Control"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1")

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 1
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -180.0
offset_top = -60.0
offset_right = 180.0
offset_bottom = 60.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.14, 0.29, 0.32, 1)
theme_override_font_sizes/font_size = 24
text = "ui.loading.title"
horizontal_alignment = 1

[node name="Stage" type="Label" parent="Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.25, 0.38, 0.4, 1)
theme_override_font_sizes/font_size = 16
text = "ui.loading.scene"
horizontal_alignment = 1

[node name="Progress" type="ProgressBar" parent="Column"]
custom_minimum_size = Vector2(0, 2)
layout_mode = 2
mouse_filter = 2
theme_override_styles/background = SubResource("Track")
theme_override_styles/fill = SubResource("Fill")
step = 1.0
show_percentage = false

[node name="Count" type="Label" parent="Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.25, 0.38, 0.4, 0.8)
theme_override_font_sizes/font_size = 14
text = "0 / 0"
horizontal_alignment = 1
