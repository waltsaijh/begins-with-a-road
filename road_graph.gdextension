[configuration]
entry_symbol = "road_graph_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]
windows.debug.x86_64 = "res://bin/road_graph.editguard.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/road_graph.editguard.windows.template_release.x86_64.dll"
web.debug.wasm32 = "res://bin/road_graph.editguard.web.template_debug.wasm32.nothreads.wasm"
web.release.wasm32 = "res://bin/road_graph.editguard.web.template_release.wasm32.nothreads.wasm"
