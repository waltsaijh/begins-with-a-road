extends SceneTree
const Fixture = preload("res://tests/fixtures/level_fixture.gd")
const Artifacts = preload("res://tests/fixtures/test_artifacts.gd")
const Progress = preload("res://scripts/levels/level_progress.gd")
var failures := 0
func _initialize(): verify.call_deferred()
func check(value: bool, message: String):
	if not value:
		failures += 1
		push_error(message)
func ids(catalog: LevelCatalog) -> Array:
	return catalog.maps.map(func(entry): return entry.id)
func verify():
	var a := Fixture.level("a")
	var b := Fixture.level("b",PackedStringArray(["a","a"]))
	var c := Fixture.level("c",PackedStringArray(["a"]))
	var d := Fixture.level("d",PackedStringArray(["b","c"]))
	var catalog := LevelCatalog.new()
	var auto_id:=Fixture.level("")
	auto_id.take_over_path("res://assets/data/levels/chapter/auto_map.tres")
	check(auto_id.progress_id()=="chapter/auto_map" and auto_id.title_key()=="ui.maps.title.chapter/auto_map" and auto_id.description_key()=="ui.maps.description.chapter/auto_map","Blank ID/translation keys did not derive from the Level filename")
	check(a.title_key()=="ui.maps.title.a" and a.description_key()=="ui.maps.description.a","Translation keys did not derive from the explicit Level ID")
	catalog.build([])
	check(catalog.maps.is_empty() and catalog.diagnostics.is_empty(),"Empty catalog was not handled")
	catalog.build([d,c,b,a])
	check(ids(catalog)==["a","b","c","d"],"Diamond did not list prerequisites before children and sort siblings by ID")
	check(catalog.by_id.a.unlocked and not catalog.by_id.b.unlocked and not catalog.by_id.d.unlocked,"Root/prerequisite lock incorrect")
	check(catalog.by_id.b.requirements.size()==1,"Duplicate edges were not deduplicated")
	catalog.refresh({"a":true,"b":true})
	check(catalog.by_id.c.unlocked and not catalog.by_id.d.unlocked,"AND prerequisites accepted a partial branch")
	catalog.refresh({"a":true,"b":true,"c":true})
	check(catalog.by_id.d.unlocked,"Diamond DAG did not unlock")
	check(ids(catalog)==["a","b","c","d"],"Completion changed the topological map indices")
	# Children can sort before their parents alphabetically. Separate roots and
	# cross-parent siblings still need a stable, dependency-first display order.
	var root_z:=Fixture.level("z_root")
	var root_m:=Fixture.level("m_root")
	root_z.take_over_path("res://assets/data/levels/a_filename.tres")
	root_m.take_over_path("res://assets/data/levels/z_filename.tres")
	var child_a:=Fixture.level("a_child",PackedStringArray(["z_root"]))
	var child_b:=Fixture.level("b_child",PackedStringArray(["m_root"]))
	var child_c:=Fixture.level("c_child",PackedStringArray(["z_root"]))
	var grandchild:=Fixture.level("a_grand",PackedStringArray(["b_child"]))
	var joined:=Fixture.level("z_join",PackedStringArray(["m_root","a_child","b_child"]))
	var branches:Array[LevelDefinition]=[joined,child_c,grandchild,root_z,child_b,child_a,root_m]
	var expected:=["m_root","z_root","a_child","b_child","c_child","a_grand","z_join"]
	catalog.build(branches)
	check(ids(catalog)==expected,"Multiple roots/layers used discovery, filename, or parent order instead of sibling IDs")
	branches.reverse()
	catalog.build(branches)
	check(ids(catalog)==expected,"Map ordering depended on discovery order")
	a.required_to_complete_levels=PackedStringArray(["d"])
	catalog.build([a,b,c,d],{"a":true,"b":true,"c":true,"d":true})
	check(catalog.maps.all(func(entry): return not entry.unlocked),"Cycle unlocked through old completion records")
	check(ids(catalog)==["a","b","c","d"],"Cycle entries disappeared or lost deterministic ID order")
	a.required_to_complete_levels=PackedStringArray()
	b.required_to_complete_levels=PackedStringArray(["missing"])
	catalog.build([a,b,c,d],{"a":true,"missing":true,"b":true,"c":true})
	check(not catalog.by_id.b.unlocked and not catalog.by_id.d.unlocked and catalog.by_id.c.unlocked,"Missing prerequisite failed to invalidate descendants")
	check(ids(catalog)==["a","c","b","d"],"Invalid entries did not follow the normal DAG in ID order")
	var duplicate:=Fixture.level("a")
	catalog.build([a,duplicate,c],{"a":true})
	check(catalog.maps.all(func(entry): return not entry.unlocked),"Duplicate IDs did not fail closed")
	var independent:=Fixture.level("independent")
	var self_loop:=Fixture.level("self",PackedStringArray(["self"]))
	catalog.build([self_loop,independent])
	check(catalog.by_id.independent.unlocked and not catalog.by_id.self.unlocked,"Self cycle blocked an unrelated component")
	check(ids(catalog)==["independent","self"],"Invalid branch did not remain visible after the valid DAG")
	# Long chains validate iteratively; no recursive graph traversal/stack growth.
	var chain:Array[LevelDefinition]=[]
	for i in 4096:
		var item:=LevelDefinition.new()
		item.level_id=str(i)
		item.terrain=a.terrain
		item.acts=a.acts
		if i>0: item.required_to_complete_levels=PackedStringArray([str(i-1)])
		chain.append(item)
	catalog.build(chain)
	check(catalog.diagnostics.is_empty() and catalog.maps.size()==4096,"Long DAG validation failed")
	check(catalog.maps[2].id=="2" and catalog.maps.back().id=="4095","Long chain was alphabetically sorted instead of topologically sorted")
	var directory:=Artifacts.path("levels/catalog/resources")
	DirAccess.make_dir_recursive_absolute(directory.path_join("nested"))
	check(ResourceSaver.save(a,directory.path_join("a.tres"))==OK,"Could not create discovery fixture")
	check(ResourceSaver.save(c,directory.path_join("nested/c.tres"))==OK,"Could not create nested discovery fixture")
	check(LevelCatalog.discover(directory).size()==2,"Discovery did not find new/nested level resources")
	DirAccess.remove_absolute(directory.path_join("nested/c.tres"))
	check(LevelCatalog.discover(directory).size()==1,"Discovery retained a deleted resource")
	DirAccess.remove_absolute(directory.path_join("a.tres"))
	var progress:=Progress.new()
	var path:=Artifacts.path("levels/catalog/completion.cfg")
	if FileAccess.file_exists(path): DirAccess.remove_absolute(path)
	check(progress.load_progress(path)==OK and progress.snapshot().is_empty(),"New completion file did not start empty")
	check(progress.mark_completed("a")==OK and progress.mark_completed("a")==OK,"Completion was not idempotent")
	var restored:=Progress.new()
	check(restored.load_progress(path)==OK and restored.snapshot().has("a"),"Completion did not survive reload")
	FileAccess.open(path,FileAccess.WRITE).store_string("[progress]\nversion=1\ncompleted=123\n")
	check(restored.load_progress(path)==ERR_INVALID_DATA and restored.snapshot().has("a"),"Malformed save destroyed in-memory completion")
	progress.free()
	restored.free()
	var saved:LevelDefinition=load("res://assets/data/levels/frontier.tres")
	check(saved.progress_id()=="frontier" and LevelCatalog.discover().has(saved),"Formal catalog does not discover Frontier")
	catalog.build(LevelCatalog.discover())
	if catalog.by_id.has("bridge") and catalog.by_id.bridge.requirements.has("frontier"):
		check(ids(catalog).find("frontier")<ids(catalog).find("bridge"),"Formal Bridge appeared before its Frontier prerequisite")
	LevelLaunch.select(c)
	check(LevelLaunch.take(a)==c and LevelLaunch.take(a)==a,"Selected level handoff was stale or mutated fallback")
	var result:={"failures":failures,"topological_layers_and_sibling_ids":true,"diamond_and":true,"cycles_missing_duplicates":true,"chain_nodes":4096,"recursive_discovery":true,"completion_reload":true,"formal_order":ids(catalog)}
	FileAccess.open(Artifacts.path("levels/catalog/result.json"),FileAccess.WRITE).store_string(JSON.stringify(result))
	print("LEVEL_CATALOG_CHECK:",JSON.stringify(result))
	quit(int(failures>0))
