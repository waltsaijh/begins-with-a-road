[gd_resource type="Resource" script_class="RelicDefinition" format=3]
[ext_resource type="Script" path="res://scripts/relics/relic_definition.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/sprites/towers/ballista.png" id="icon"]
[ext_resource type="Resource" path="res://assets/data/towers/ballista.tres" id="tower"]
[resource]
script = ExtResource("script")
id = &"secret_mission"
name_key = "relic.secret_mission.name"
description_key = "relic.secret_mission.description"
icon = ExtResource("icon")
tower = ExtResource("tower")
parameters = {"radius": 3.0, "damage_multiplier": 2.0}
