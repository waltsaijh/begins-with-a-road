[gd_resource type="Resource" script_class="RelicDefinition" format=3]
[ext_resource type="Script" path="res://scripts/relics/relic_definition.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/sprites/towers/crossfire.png" id="icon"]
[ext_resource type="Resource" path="res://assets/data/towers/crossfire.tres" id="tower"]
[resource]
script = ExtResource("script")
id = &"small_fry"
name_key = "relic.small_fry.name"
description_key = "relic.small_fry.description"
icon = ExtResource("icon")
tower = ExtResource("tower")
parameters = {"damage_multiplier": 1.75}
