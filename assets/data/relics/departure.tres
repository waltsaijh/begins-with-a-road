[gd_resource type="Resource" script_class="RelicDefinition" format=3]
[ext_resource type="Script" path="res://scripts/relics/relic_definition.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/sprites/towers/broadside.png" id="icon"]
[ext_resource type="Resource" path="res://assets/data/towers/broadside.tres" id="tower"]
[resource]
script = ExtResource("script")
id = &"departure"
name_key = "relic.departure.name"
description_key = "relic.departure.description"
icon = ExtResource("icon")
tower = ExtResource("tower")
parameters = {"speed": 0.55}
