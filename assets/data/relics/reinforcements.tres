[gd_resource type="Resource" script_class="RelicDefinition" format=3]
[ext_resource type="Script" path="res://scripts/relics/relic_definition.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/sprites/towers/barracks.png" id="icon"]
[ext_resource type="Resource" path="res://assets/data/towers/barracks.tres" id="tower"]
[resource]
script = ExtResource("script")
id = &"reinforcements"
name_key = "relic.reinforcements.name"
description_key = "relic.reinforcements.description"
icon = ExtResource("icon")
tower = ExtResource("tower")
parameters = {"extra_units": 1}
