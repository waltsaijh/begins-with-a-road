[gd_resource type="Resource" script_class="RelicDefinition" format=3]
[ext_resource type="Script" path="res://scripts/relics/relic_definition.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/sprites/relics/gold.svg" id="icon"]
[resource]
script = ExtResource("script")
id = &"gold"
name_key = "relic.gold.name"
description_key = "relic.gold.description"
icon = ExtResource("icon")
repeatable = true
max_stacks = 5
parameters = {"amount": 20}
