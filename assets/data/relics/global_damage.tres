[gd_resource type="Resource" script_class="RelicDefinition" format=3]
[ext_resource type="Script" path="res://scripts/relics/relic_definition.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/sprites/relics/global_damage.svg" id="icon"]
[resource]
script = ExtResource("script")
id = &"global_damage"
name_key = "relic.global_damage.name"
description_key = "relic.global_damage.description"
icon = ExtResource("icon")
repeatable = true
max_stacks = 3
parameters = {"bonus": 0.1}
