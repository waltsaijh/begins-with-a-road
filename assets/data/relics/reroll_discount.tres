[gd_resource type="Resource" script_class="RelicDefinition" format=3]
[ext_resource type="Script" path="res://scripts/relics/relic_definition.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/sprites/relics/reroll_discount.svg" id="icon"]
[resource]
script = ExtResource("script")
id = &"reroll_discount"
name_key = "relic.reroll_discount.name"
description_key = "relic.reroll_discount.description"
icon = ExtResource("icon")
repeatable = true
max_stacks = 2
parameters = {"amount": 1}
