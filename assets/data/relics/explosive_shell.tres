[gd_resource type="Resource" script_class="RelicDefinition" format=3]
[ext_resource type="Script" path="res://scripts/relics/relic_definition.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/sprites/towers/mortar.png" id="icon"]
[ext_resource type="Resource" path="res://assets/data/towers/mortar.tres" id="tower"]
[resource]
script = ExtResource("script")
id = &"explosive_shell"
name_key = "relic.explosive_shell.name"
description_key = "relic.explosive_shell.description"
icon = ExtResource("icon")
tower = ExtResource("tower")
parameters = {"every": 3, "radius_multiplier": 1.8, "friendly_multiplier": 1.0}
